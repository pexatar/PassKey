<UserControl
    x:Class="PassKey.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <!-- Section header: icon + title, used to divide the flat settings list -->
        <Style x:Key="SettingsSectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScroller" Padding="24">
        <StackPanel Spacing="4" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock x:Uid="PageSettings" Text="Impostazioni"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12"
                       AutomationProperties.HeadingLevel="Level1" />

            <!-- Language restart notice (global) -->
            <InfoBar x:Name="LanguageRestartInfoBar"
                     x:Uid="LanguageRestartInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     AutomationProperties.LiveSetting="Polite"
                     Severity="Informational"
                     Title="Riavvio necessario"
                     Message="Riavvia PassKey per applicare la nuova lingua."
                     Margin="0,4,0,4">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartNowButton"
                            x:Uid="LanguageRestartNowButton"
                            Content="Riavvia ora"
                            Click="RestartNowButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ═══ GENERALI ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE713;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsGeneral" Text="Generali"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsLanguage" Text="Lingua" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsLanguageRestart"
                               Text="La nuova lingua si applica al riavvio"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ComboBox x:Name="LanguageCombo" Width="200"
                          SelectionChanged="LanguageCombo_SelectionChanged"
                          TabIndex="10">
                    <ComboBoxItem x:Uid="LangSystem" Content="Sistema (Auto)" Tag="auto" />
                    <ComboBoxItem Content="Italiano" Tag="it-IT" />
                    <ComboBoxItem Content="English" Tag="en-GB" />
                    <ComboBoxItem Content="Français" Tag="fr-FR" />
                    <ComboBoxItem Content="Español" Tag="es-ES" />
                    <ComboBoxItem Content="Português" Tag="pt-PT" />
                    <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsStartWithWindows" Text="Avvio all'accensione" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsStartWithWindowsDesc"
                               Text="Avvia PassKey automaticamente all'accensione del computer"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ToggleSwitch x:Name="StartWithWindowsToggle"
                              Toggled="StartWithWindowsToggle_Toggled"
                              TabIndex="20" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsStartMinimized" Text="Avvia minimizzato" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsStartMinimizedDesc"
                               Text="Mostra PassKey nella barra delle applicazioni all'avvio"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <CheckBox x:Name="StartMinimizedCheck"
                          IsEnabled="False"
                          Checked="StartMinimizedCheck_Changed"
                          Unchecked="StartMinimizedCheck_Changed"
                          TabIndex="30" />
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="BrowserExtensionButton"
                             IsClickEnabled="True"
                             Click="BrowserExtensionButton_Click">
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsBrowserExtTitle" Text="Estensione per il browser" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsBrowserExtDesc"
                               Text="Compila automaticamente le credenziali nei siti web"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <!-- ═══ INTERFACCIA UTENTE ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE771;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsUI" Text="Interfaccia utente"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsTheme" Text="Tema" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsThemeDesc"
                               Text="Personalizza l'aspetto visivo dell'applicazione"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ComboBox x:Name="ThemeCombo" Width="200"
                          SelectionChanged="ThemeCombo_SelectionChanged"
                          TabIndex="40">
                    <ComboBoxItem x:Uid="ThemeSystem" Content="Sistema" Tag="0" />
                    <ComboBoxItem x:Uid="ThemeLight" Content="Chiaro" Tag="1" />
                    <ComboBoxItem x:Uid="ThemeDark" Content="Scuro" Tag="2" />
                </ComboBox>
            </tk:SettingsCard>

            <!-- ═══ SICUREZZA ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE72E;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsSecurity" Text="Sicurezza"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsAutoLockTitle" Text="Blocco automatico" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsAutoLockDesc"
                               Text="Blocca il vault dopo un periodo di inattività"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ComboBox x:Name="AutoLockCombo" Width="140"
                          SelectionChanged="AutoLockCombo_SelectionChanged"
                          TabIndex="50">
                    <ComboBoxItem x:Uid="AutoLock30sItem" Content="30 secondi" />
                    <ComboBoxItem x:Uid="AutoLock1mItem" Content="1 minuto" />
                    <ComboBoxItem x:Uid="AutoLock5mItem" Content="5 minuti" />
                    <ComboBoxItem x:Uid="AutoLock10mItem" Content="10 minuti" />
                    <ComboBoxItem x:Uid="AutoLockNeverItem" Content="Mai" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsChangeMasterPwTitle" Text="Cambia master password" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsChangeMasterPwDesc"
                               Text="Modifica la password principale del vault"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button x:Name="ChangePwButton"
                        x:Uid="SettingsChangePwBtn"
                        Content="Cambia password"
                        Click="ChangePwButton_Click"
                        TabIndex="60" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsHibpTitle" Text="Controlla password compromesse" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsHibpDesc"
                               Text="Verifica le password contro Have I Been Pwned. Solo i primi 5 caratteri dell'hash SHA-1 lasciano il dispositivo (k-anonymity)."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ToggleSwitch x:Name="HibpToggle"
                              x:Uid="SettingsHibpToggle"
                              Toggled="HibpToggle_Toggled"
                              TabIndex="65" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsClearVaultTitle" Text="Svuota vault" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsClearVaultDesc"
                               Text="Elimina tutte le password, carte, identità e note. Operazione irreversibile."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button x:Name="ClearVaultButton"
                        Click="ClearVaultButton_Click"
                        TabIndex="66">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                  Foreground="{ThemeResource StatRemovedBrush}" />
                        <TextBlock x:Uid="SettingsClearVaultBtn" Text="Svuota vault" />
                    </StackPanel>
                </Button>
            </tk:SettingsCard>

            <!-- ═══ BACKUP E IMPORTAZIONE ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE8AC;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsBackupSection" Text="Backup e importazione"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsBackupCreateTitle" Text="Crea backup" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsBackupCreateDesc"
                               Text="Esporta una copia cifrata del vault"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button x:Name="BackupButton" x:Uid="SettingsBackupCreateBtn"
                        Content="Backup"
                        Click="BackupButton_Click"
                        TabIndex="70" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsRestoreTitle" Text="Ripristina backup" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsRestoreDesc"
                               Text="Importa un vault da un file di backup"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button x:Name="RestoreButton" x:Uid="SettingsRestoreBtn"
                        Content="Ripristina"
                        Click="RestoreButton_Click"
                        TabIndex="80" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsImportTitle" Text="Importa dati" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsImportDesc"
                               Text="Importa password da un altro gestore"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <Button x:Name="ImportButton" x:Uid="SettingsImportBtn"
                        Content="Importa"
                        Click="ImportButton_Click"
                        TabIndex="90" />
            </tk:SettingsCard>

            <!-- ═══ AGGIORNAMENTI ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE895;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsUpdatesSection" Text="Aggiornamenti"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsAutoUpdateTitle" Text="Controllo automatico" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsAutoUpdateDesc"
                               Text="Verifica nuove versioni all'avvio"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ToggleSwitch x:Name="AutoUpdateToggle"
                              Toggled="AutoUpdateToggle_Toggled" TabIndex="91" />
            </tk:SettingsCard>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsCheckUpdateTitle" Text="Controlla aggiornamenti" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="UpdateStatusTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="UpdateCheckRing" Width="20" Height="20"
                                  IsActive="False" Visibility="Collapsed" />
                    <Button x:Name="CheckUpdateButton" x:Uid="SettingsCheckUpdateBtn"
                            Content="Controlla ora"
                            Click="CheckUpdateButton_Click" TabIndex="92" />
                </StackPanel>
            </tk:SettingsCard>

            <!-- ═══ INFORMAZIONI ═══ -->
            <StackPanel Style="{StaticResource SettingsSectionHeader}">
                <FontIcon Glyph="&#xE946;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="SettingsInfoSection" Text="Informazioni"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <tk:SettingsCard>
                <tk:SettingsCard.Header>
                    <TextBlock>
                        <Run Text="PassKey" /><Run Text=" v" /><Run x:Name="VersionText" Text="1.0.0" />
                    </TextBlock>
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SettingsAppDesc"
                               Text="Password manager sicuro per Windows"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="ActivityLogButton"
                             IsClickEnabled="True"
                             Click="ActivityLogButton_Click">
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsActivityLogBtn" Text="Cronologia attività" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="HelpButton"
                             IsClickEnabled="True"
                             Click="HelpButton_Click"
                             Margin="0,0,0,24">
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SettingsHelpBtn" Text="Guida e scorciatoie" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE897;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
