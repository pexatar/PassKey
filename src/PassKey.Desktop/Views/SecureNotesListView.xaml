<UserControl
    x:Class="PassKey.Desktop.Views.SecureNotesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PassKey.Desktop.Controls"
    KeyDown="OnViewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Master panel (note list, 320px) -->
            <ColumnDefinition Width="320" />
            <!-- Detail panel (editor, remaining space) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Master: Note list -->
        <Grid Grid.Column="0" RowSpacing="0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header: titolo + imbuto -->
                <RowDefinition Height="*" />     <!-- Lista / EmptyState -->
            </Grid.RowDefinitions>

            <!-- Header: page title + category filter (search + add moved to the detail panel) -->
            <Grid Grid.Row="0" Padding="16,16,16,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- Titolo -->
                    <ColumnDefinition Width="Auto" />  <!-- Filter button -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Uid="PageNotes" Text="Note sicure"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />

                <!-- Filter icon button con MenuFlyout + RadioMenuFlyoutItem (tooltip set in code-behind) -->
                <Button x:Name="FilterButton" Grid.Column="1"
                        VerticalAlignment="Center"
                        TabIndex="2"
                        Padding="8">
                    <Grid>
                        <FontIcon x:Name="FilterIcon" Glyph="&#xE71C;" FontSize="16" />
                        <!-- Badge dot: visibile quando un filtro categoria e attivo -->
                        <Ellipse x:Name="FilterBadge" Width="8" Height="8"
                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="6,-4,-4,0" Visibility="Collapsed" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="CategoryFilterFlyout" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Note mini-cards list -->
            <ListView Grid.Row="1"
                      x:Name="NotesList"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="NotesList_ItemClick"
                      ContainerContentChanging="NotesList_ContainerContentChanging"
                      TabIndex="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Section header: "Fissate" o "Note" (visibile solo sul primo elemento di ogni sezione) -->
                            <TextBlock Text=""
                                       Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="4,4,0,6"
                                       AutomationProperties.HeadingLevel="Level2" />

                            <!-- Note card -->
                            <Grid ColumnSpacing="10" Margin="0,2"
                                  AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Bordo colorato categoria (4px) -->
                                <Border Grid.Column="0"
                                        Width="4" CornerRadius="2"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource TextFillColorTertiaryBrush}" />

                                <!-- Contenuto card: 3 righe -->
                                <Grid Grid.Column="1" Padding="0,8" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Riga 1: Pin + Titolo + Data relativa -->
                                    <Grid Grid.Row="0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE718;"
                                                  FontSize="12" Visibility="Collapsed"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                                        <TextBlock Grid.Column="2" Text=""
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <!-- Riga 2: Preview contenuto -->
                                    <TextBlock Grid.Row="1" Text=""
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!-- Riga 3: Categoria -->
                                    <TextBlock Grid.Row="2" Text=""
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state: nessuna nota nel vault -->
            <controls:EmptyStateControl
                x:Name="EmptyState"
                Grid.Row="1"
                Visibility="Collapsed"
                Icon="&#xE70B;"
                AccentBrush="{ThemeResource NotesIconBrush}"
                Title="Nessuna nota"
                Subtitle="Crea la tua prima nota sicura per salvare informazioni riservate." />

            <!-- Empty state: filtro attivo ma 0 risultati -->
            <controls:EmptyStateControl
                x:Name="FilteredEmptyState"
                Grid.Row="1"
                Visibility="Collapsed"
                Icon="&#xF78B;"
                Title="Nessun risultato"
                Subtitle="Prova a modificare i filtri o la ricerca." />
        </Grid>

        <!-- Detail panel: toolbar (search + add) on top, editor/empty below -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Toolbar: search + add -->
                <RowDefinition Height="*" />     <!-- Editor / empty placeholder -->
            </Grid.RowDefinitions>

            <!-- Toolbar: search + add, top-right -->
            <Grid Grid.Row="0" Padding="16,16,24,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />  <!-- Search -->
                    <ColumnDefinition Width="Auto" />  <!-- Add -->
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Uid="SearchNotes" Grid.Column="1"
                                x:Name="SearchBox"
                                PlaceholderText="Cerca note..."
                                QueryIcon="Find"
                                Width="280"
                                VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged"
                                TabIndex="1" />

                <Button Grid.Column="2"
                        x:Uid="AddNoteBtn"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="AddButton_Click"
                        TabIndex="3"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="ButtonAddNote" Text="Aggiungi" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Editor / empty placeholder -->
            <Grid Grid.Row="1">
                <!-- Editor panel -->
                <Grid x:Name="EditorPanel" Visibility="Collapsed">
                    <ContentPresenter x:Name="EditorContent" />
                </Grid>

                <!-- Empty editor placeholder -->
                <StackPanel x:Name="EmptyEditor"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12">
                    <FontIcon Glyph="&#xE70B;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Uid="EmptyEditorHint" Text="Seleziona una nota o creane una nuova"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Hidden announcer for screen reader live regions -->
        <TextBlock x:Name="A11yAnnouncer"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AccessibilityView="Content"
                   Width="1" Height="1" Opacity="0"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
