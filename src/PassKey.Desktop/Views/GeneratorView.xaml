<UserControl
    x:Class="PassKey.Desktop.Views.GeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Recent-password item styles: theme-aware (ThemeResource) so colours follow the theme. -->
        <Style x:Key="HistoryItemGridStyle" TargetType="Grid">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="HistoryTimeTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="8" MaxWidth="700" HorizontalAlignment="Left">

            <!-- Page title -->
            <TextBlock x:Uid="PageGenerator" Text="Generatore password"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,16"
                       AutomationProperties.HeadingLevel="Level1" />

            <!-- ═══ HERO CARD: password + strength ═══ -->
            <!-- Width fissa: layout stabile, non si dilata con password lunghe (LOC-01 UI fix) -->
            <Grid Padding="20"
                  Width="560"
                  HorizontalAlignment="Left"
                  CornerRadius="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <StackPanel Spacing="12">

                    <!-- Password display + action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Riga singola con clip netto (ScrollViewer scroll-disabled). WinUI 3 non
                             supporta OpacityMask, quindi niente dissolvenza: il testo viene troncato
                             in modo pulito al bordo. Valore completo sempre via Copia. -->
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center">
                            <RichTextBlock x:Name="PasswordDisplay"
                                           x:Uid="GenPasswordDisplay"
                                           FontFamily="Cascadia Mono"
                                           FontSize="22"
                                           CharacterSpacing="60"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center">
                                <Paragraph x:Name="PasswordParagraph" />
                            </RichTextBlock>
                        </ScrollViewer>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="CopyButton"
                                    x:Uid="GenCopyBtn"
                                    Click="CopyButton_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8" TabIndex="70">
                                <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="16" />
                            </Button>
                            <Button x:Name="RegenerateButton"
                                    x:Uid="GenRegenBtn"
                                    Click="RegenerateButton_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8" TabIndex="80">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Strength: score + bar + label -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Score number -->
                        <TextBlock x:Name="ScoreText" Grid.Column="0"
                                   Text="0"
                                   FontSize="28" FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <!-- 5-segment bar -->
                        <Grid x:Name="StrengthBarGrid" Grid.Column="1"
                              ColumnSpacing="4" Height="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StrengthSeg0" Grid.Column="0" CornerRadius="4"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                            <Border x:Name="StrengthSeg1" Grid.Column="1" CornerRadius="4"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                            <Border x:Name="StrengthSeg2" Grid.Column="2" CornerRadius="4"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                            <Border x:Name="StrengthSeg3" Grid.Column="3" CornerRadius="4"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                            <Border x:Name="StrengthSeg4" Grid.Column="4" CornerRadius="4"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                        </Grid>

                        <!-- Strength label + crack time -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="StrengthLabel" Text="—"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="CrackTimeText" Text="—"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Grid>

            <!-- ═══ OPZIONI ═══ -->
            <MenuFlyoutSeparator Margin="0,12" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <FontIcon Glyph="&#xE713;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="GeneratorOptionsHeader" Text="Opzioni"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <!-- Lunghezza -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LengthHeaderText"
                               x:Uid="GeneratorLength"
                               Text="Lunghezza"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="LengthLabel" Grid.Column="1"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Slider x:Name="LengthSlider"
                        x:Uid="GenLengthSlider"
                        Minimum="8" Maximum="128"
                        StepFrequency="1" SnapsTo="StepValues"
                        ValueChanged="LengthSlider_ValueChanged"
                        TabIndex="10" />
            </StackPanel>

            <!-- Maiuscole -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="GeneratorUppercase"
                               Text="Maiuscole (A-Z)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="GenUpperDesc"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch x:Name="UppercaseToggle" Grid.Column="1"
                              x:Uid="GenUpperToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center"
                              Toggled="CharsetToggle_Toggled"
                              TabIndex="20" />
            </Grid>

            <!-- Minuscole -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="GeneratorLowercase"
                               Text="Minuscole (a-z)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="GenLowerDesc"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch x:Name="LowercaseToggle" Grid.Column="1"
                              x:Uid="GenLowerToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center"
                              Toggled="CharsetToggle_Toggled"
                              TabIndex="30" />
            </Grid>

            <!-- Numeri -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="GeneratorDigits"
                               Text="Numeri (0-9)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="GenDigitsDesc"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch x:Name="DigitsToggle" Grid.Column="1"
                              x:Uid="GenDigitsToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center"
                              Toggled="CharsetToggle_Toggled"
                              TabIndex="40" />
            </Grid>

            <!-- Simboli -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="GeneratorSymbols"
                               Text="Simboli (#$&amp;)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="GenSpecialDesc"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch x:Name="SymbolsToggle" Grid.Column="1"
                              x:Uid="GenSymbolsToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center"
                              Toggled="CharsetToggle_Toggled"
                              TabIndex="50" />
            </Grid>

            <MenuFlyoutSeparator Margin="0,12" />

            <!-- Escludi caratteri ambigui -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="GeneratorExcludeAmbiguous" Text="Escludi caratteri ambigui"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="GenExcludeAmbiguousDesc"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ToggleSwitch x:Name="ExcludeAmbiguousToggle" Grid.Column="1"
                              x:Uid="GenExcludeToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center"
                              Toggled="CharsetToggle_Toggled"
                              TabIndex="55" />
            </Grid>

            <!-- ═══ PASSWORD RECENTI ═══ -->
            <MenuFlyoutSeparator Margin="0,12" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <FontIcon Glyph="&#xE81C;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Uid="GeneratorRecentPasswords" Text="Password recenti"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>

            <StackPanel x:Name="HistoryList" Spacing="4" />

            <TextBlock x:Name="HistoryEmptyText"
                       x:Uid="GeneratorNoPasswords"
                       Text="Nessuna password generata"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,24" />

            <!-- Hidden announcer for screen reader -->
            <TextBlock x:Name="A11yAnnouncer"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.AccessibilityView="Content"
                       Width="1" Height="1" Opacity="0"
                       IsHitTestVisible="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
