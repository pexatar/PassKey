<controls:DetailPanelBase
    x:Class="PassKey.Desktop.Views.SecureNoteDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PassKey.Desktop.Controls"
    xmlns:conv="using:PassKey.Desktop.Converters"
    xmlns:items="using:PassKey.Desktop.ViewModels.Items"
    xmlns:ctMarkdown="using:CommunityToolkit.WinUI.UI.Controls">

    <controls:DetailPanelBase.Resources>
        <conv:NoteCategoryBrushConverter x:Key="NoteCategoryBrush" />
        <conv:BoolToButtonStyleConverter x:Key="BoolToButtonStyle" />
    </controls:DetailPanelBase.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Editor content -->
        <Grid Grid.Row="0" Padding="24" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header: Titolo + Categoria sulla stessa riga -->
                <RowDefinition Height="Auto" />  <!-- Toggle bar: Modifica / Anteprima + counters -->
                <RowDefinition Height="*" />     <!-- Area testo principale -->
            </Grid.RowDefinitions>

            <!-- Row 0: Titolo e Categoria sulla stessa riga -->
            <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />    <!-- Titolo -->
                    <ColumnDefinition Width="Auto" /> <!-- Categoria + dot colorato -->
                </Grid.ColumnDefinitions>

                <!-- Titolo con indicatore "non salvato" -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="TitleLabel" x:Uid="FieldTitle" Text="Titolo *"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <Ellipse x:Name="UnsavedDot" Width="8" Height="8"
                                 x:Uid="NoteUnsavedDot"
                                 Fill="{ThemeResource NotesIconBrush}"
                                 Visibility="{x:Bind Vm.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox x:Name="TitleBox"
                             x:Uid="NotesTitleBox"
                             Text="{x:Bind Vm.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{x:Bind TitleLabel}"
                             TabIndex="10" />
                    <TextBlock x:Uid="FieldTitleError"
                               Text="Campo obbligatorio"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind Vm.IsTitleEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Categoria + dot colorato a destra -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="CategoryLabel" x:Uid="FieldCategory" Text="Categoria"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ComboBox x:Name="CategoryCombo"
                              x:Uid="NoteCategoryCombo"
                              MinWidth="140"
                              ItemsSource="{x:Bind CategoryOptions}"
                              SelectedItem="{x:Bind Vm.SelectedCategoryOption, Mode=TwoWay}"
                              AutomationProperties.LabeledBy="{x:Bind CategoryLabel}"
                              TabIndex="20">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="items:NoteCategoryOption">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            AutomationProperties.Name="{x:Bind Name}">
                                    <Border Width="12" Height="12" CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind Category, Converter={StaticResource NoteCategoryBrush}}" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Row 1: Toggle bar Modifica / Anteprima + contatore caratteri e parole -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="EditModeBtn"
                            x:Uid="NoteEditModeBtn"
                            Style="{x:Bind Vm.IsPreviewMode, Mode=OneWay, Converter={StaticResource BoolToButtonStyle}, ConverterParameter=Invert}"
                            Padding="10,4"
                            Command="{x:Bind Vm.ShowEditorCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            <TextBlock x:Uid="NotesEditButton" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PreviewModeBtn"
                            x:Uid="NotePreviewModeBtn"
                            Style="{x:Bind Vm.IsPreviewMode, Mode=OneWay, Converter={StaticResource BoolToButtonStyle}}"
                            Padding="10,4"
                            Command="{x:Bind Vm.ShowPreviewCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE890;" FontSize="12" />
                            <TextBlock x:Uid="NotesPreviewButton" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="CharCountText"
                           Text="{x:Bind Vm.CounterText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <!-- Row 2: Area testo — TextBox (edit) o MarkdownTextBlock (preview) -->
            <Grid Grid.Row="2">
                <TextBox x:Name="ContentBox"
                         x:Uid="NotesContentBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Text="{x:Bind Vm.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{x:Bind Vm.IsEditorVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                         LostFocus="ContentBox_LostFocus"
                         VerticalAlignment="Stretch"
                         TabIndex="30" />

                <ScrollViewer x:Name="PreviewScroll"
                              Visibility="{x:Bind Vm.IsPreviewMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto">
                    <ctMarkdown:MarkdownTextBlock x:Name="MarkdownPreview"
                                                  x:Uid="NoteMarkdownPreview"
                                                  Text="{x:Bind Vm.PreviewMarkdown, Mode=OneWay}"
                                                  Padding="4" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Sticky footer con pulsanti azione -->
        <Grid Grid.Row="1" Padding="24,12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Elimina -->
                <ColumnDefinition Width="Auto" />  <!-- Pin -->
                <ColumnDefinition Width="*" />     <!-- Spacer -->
                <ColumnDefinition Width="Auto" />  <!-- Annulla -->
                <ColumnDefinition Width="Auto" />  <!-- Salva -->
            </Grid.ColumnDefinitions>

            <!-- Elimina (solo per note esistenti) -->
            <Button x:Name="DeleteButton"
                    Grid.Column="0"
                    x:Uid="NoteDeleteButton"
                    Visibility="{x:Bind Vm.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Command="{x:Bind Vm.DeleteCommand, Mode=OneWay}"
                    TabIndex="40">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource StatRemovedBrush}" />
                    <TextBlock x:Uid="ButtonDelete" Text="Elimina" Foreground="{ThemeResource StatRemovedBrush}" />
                </StackPanel>
            </Button>

            <!-- Pin toggle. IsChecked follows the ViewModel; the click goes through the command. -->
            <ToggleButton x:Name="PinToggle"
                          Grid.Column="1"
                          x:Uid="NotePinToggle"
                          IsChecked="{x:Bind Vm.IsPinned, Mode=OneWay}"
                          Command="{x:Bind Vm.TogglePinCommand, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Vm.PinAccessibleName, Mode=OneWay}"
                          TabIndex="45">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                    <TextBlock x:Name="PinToggleText" Text="{x:Bind Vm.PinButtonText, Mode=OneWay}" />
                </StackPanel>
            </ToggleButton>

            <!-- Annulla -->
            <Button x:Uid="ButtonCancel"
                    Grid.Column="3"
                    Content="Annulla"
                    Command="{x:Bind Vm.CancelCommand, Mode=OneWay}"
                    TabIndex="48" />

            <!-- Salva. IsEnabled is intentionally absent: WinUI derives it from CanExecute. -->
            <Button x:Name="SaveButton"
                    Grid.Column="4"
                    x:Uid="NoteSaveButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Vm.SaveCommand, Mode=OneWay}"
                    TabIndex="50">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:Name="SaveProgress"
                                  IsActive="{x:Bind Vm.IsSaving, Mode=OneWay}"
                                  Visibility="{x:Bind Vm.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                  Width="14" Height="14" />
                    <TextBlock x:Name="SaveButtonText" Text="{x:Bind Vm.SaveButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Hidden announcer for screen reader live regions -->
        <TextBlock x:Name="A11yAnnouncer"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.AccessibilityView="Content"
                   Width="1" Height="1" Opacity="0"
                   IsHitTestVisible="False" />
    </Grid>
</controls:DetailPanelBase>
