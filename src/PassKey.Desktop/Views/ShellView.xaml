<UserControl
    x:Class="PassKey.Desktop.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        KeyboardAcceleratorPlacementMode="Hidden"
        SelectionChanged="NavView_SelectionChanged"
        ItemInvoked="NavView_ItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavDashboard" Content="Dashboard" Tag="0"
                                AutomationProperties.Name="Dashboard">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Uid="NavPasswords" Content="Password" Tag="1"
                                AutomationProperties.Name="Password">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Uid="NavCards" Content="Carte" Tag="2"
                                AutomationProperties.Name="Carte di credito">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8C7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Uid="NavIdentities" Content="Identità" Tag="3"
                                AutomationProperties.Name="Identità">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Uid="NavNotes" Content="Note" Tag="4"
                                AutomationProperties.Name="Note sicure">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem x:Uid="NavGenerator" Content="Generatore" Tag="5"
                                AutomationProperties.Name="Generatore password">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Uid="NavVerifier" Content="Verifica" Tag="6"
                                AutomationProperties.Name="Verifica password">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D5;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="NavLockVault" Content="Blocca Vault" Tag="lock"
                                KeyboardAcceleratorPlacementMode="Hidden"
                                AutomationProperties.Name="Blocca vault">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="NavItemHelp"
                                x:Uid="NavHelp" Content="Guida" Tag="help"
                                AutomationProperties.Name="Guida">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE897;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!-- Keyboard shortcuts -->
        <NavigationView.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="LockVault_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewItem_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number7" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="NavShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="H" Invoked="Help_Invoked" />
        </NavigationView.KeyboardAccelerators>

        <!-- Page content area + update InfoBar -->
        <Grid RowDefinitions="Auto,*">

            <!-- Update-available InfoBar — appears only when a newer release is detected -->
            <InfoBar x:Name="UpdateInfoBar"
                     Grid.Row="0"
                     IsOpen="{x:Bind ViewModel.IsUpdateInfoBarOpen, Mode=OneWay}"
                     Title="{x:Bind ViewModel.UpdateInfoBarTitle, Mode=OneWay}"
                     x:Uid="UpdateInfoBar"
                     Severity="Informational"
                     IsClosable="True"
                     Closed="UpdateInfoBar_Closed"
                     Margin="8,4,8,0">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">

                        <!-- "Scarica e installa" — visible before/after download, hidden during -->
                        <Button x:Uid="UpdateDownloadButton"
                                Content="Scarica e installa"
                                Command="{x:Bind ViewModel.DownloadAndInstallCommand}"
                                Visibility="{x:Bind ViewModel.IsNotDownloading,
                                             Converter={StaticResource BoolToVisibility},
                                             Mode=OneWay}" />

                        <!-- Progress bar — visible only while downloading -->
                        <ProgressBar Minimum="0" Maximum="100" Width="160"
                                     Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind ViewModel.IsDownloading,
                                                  Converter={StaticResource BoolToVisibility},
                                                  Mode=OneWay}" />

                        <!-- "Novità" — always visible -->
                        <Button x:Uid="UpdateReleaseNotesButton"
                                Content="Novità"
                                Command="{x:Bind ViewModel.OpenReleasePageCommand}" />

                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <ContentPresenter x:Name="ShellContent" Grid.Row="1" />

        </Grid>

    </NavigationView>
</UserControl>
